IF
  Global("C0AutoCreated", "GLOBAL", 0)
  ClassLevelLT("C0AURA",ROGUE,14)  // Aura
THEN RESPONSE #100
  SetInterrupt(FALSE)
  SetGlobal("SPRITE_IS_DEADC0AUIN3","GLOBAL",0)
  SetGlobal("C0AutoCreated", "GLOBAL", 1)
  ActionOverride("C0AURA",ReallyForceSpellRES("c0auin3a",Myself))
  SetInterrupt(TRUE)
  DestroySelf()
END

IF
  Global("C0AutoCreated", "GLOBAL", 0)
    ClassLevelGT("C0AURA",ROGUE,13)  // Aura
    ClassLevelLT("C0AURA",ROGUE,22)  // Aura
THEN RESPONSE #100
