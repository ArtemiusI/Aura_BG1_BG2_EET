IF
  Global("C0AutoCreated", "GLOBAL", 1)
  OR(2)
  !HPLT("C0AUIN3",1)
  Dead("C0AUIN3")
THEN RESPONSE #100
  SetGlobal("C0AutoCreated", "GLOBAL", 0)
  Continue()
END

IF
  Global("C0AutoCreated", "GLOBAL", 1)
  !Dead("C0AUIN3")
  InMyArea("C0AUIN3")
THEN RESPONSE #100
	DisplayString("C0AURA",~An automaton is already currently active.~)
	DestroySelf()
END

IF
  Global("C0AutoCreated", "GLOBAL", 1)
  !Dead("C0AUIN3")
  !InMyArea("C0AUIN3")
THEN RESPONSE #100
	MoveGlobalObject("C0AUIN3","C0AURA")
	DisplayString("C0AURA",~An automaton is already currently active.~)
	DestroySelf()
END